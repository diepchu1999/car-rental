<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.carrental</groupId>
    <artifactId>car-rental-keycloak</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <properties>
        <!-- Image Keycloak 26.7.2 chạy Java 21; không kế thừa Java 25 của backend. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <keycloak.version>26.7.2</keycloak.version>
        <junit.version>5.12.2</junit.version>
        <testcontainers.version>2.0.5</testcontainers.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.keycloak</groupId><artifactId>keycloak-services</artifactId>
            <version>${keycloak.version}</version><scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId><artifactId>keycloak-model-jpa</artifactId>
            <version>${keycloak.version}</version><scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.googlecode.libphonenumber</groupId><artifactId>libphonenumber</artifactId>
            <version>9.0.41</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version><scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId><artifactId>mockito-core</artifactId>
            <version>5.23.0</version><scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId><artifactId>jsoup</artifactId>
            <version>1.19.1</version><scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId><artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version><scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId><artifactId>postgresql</artifactId>
            <version>42.7.8</version><scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version>
                <configuration>
                    <!-- LogManager phải có ngay khi JVM test bắt đầu, trước lúc lớp logging được nạp. -->
                    <argLine>-Djava.util.logging.manager=org.jboss.logmanager.LogManager</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.0</version>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <configuration><excludes>
                            <exclude>com/carrental/keycloak/smslocal/**</exclude>
                            <exclude>META-INF/services/com.carrental.keycloak.otp.SmsSender</exclude>
                        </excludes></configuration>
                    </execution>
                    <execution>
                        <id>local-sms</id><phase>package</phase><goals><goal>jar</goal></goals>
                        <configuration><classifier>local-sms</classifier><includes>
                            <include>com/carrental/keycloak/smslocal/**</include>
                            <include>META-INF/services/com.carrental.keycloak.otp.SmsSender</include>
                        </includes></configuration>
                    </execution>
                    <execution>
                        <id>container-test-fixture</id><phase>package</phase><goals><goal>test-jar</goal></goals>
                        <configuration><includes>
                            <include>com/carrental/keycloak/probe/**</include>
                            <include>META-INF/services/org.keycloak.services.resource.RealmResourceProviderFactory</include>
                            <include>META-INF/beans.xml</include>
                        </includes></configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.1</version>
                <executions><execution><phase>package</phase><goals><goal>shade</goal></goals>
                    <configuration>
                        <createDependencyReducedPom>false</createDependencyReducedPom>
                        <artifactSet><includes><include>com.googlecode.libphonenumber:libphonenumber</include></includes></artifactSet>
                        <!-- Keycloak không cô lập classloader của provider; đổi namespace thư viện đi kèm. -->
                        <relocations><relocation>
                            <pattern>com.google.i18n.phonenumbers</pattern>
                            <shadedPattern>com.carrental.keycloak.internal.phonenumber</shadedPattern>
                        </relocation></relocations>
                    </configuration>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.5.6</version>
                <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
                <configuration>
                    <!-- Failsafe dùng JVM khác Surefire, cần cấu hình sớm ở cả hai nơi. -->
                    <argLine>-Djava.util.logging.manager=org.jboss.logmanager.LogManager</argLine>
                    <systemPropertyVariables>
                    <provider.jar>${project.build.directory}/${project.build.finalName}.jar</provider.jar>
                    <local.sms.jar>${project.build.directory}/${project.build.finalName}-local-sms.jar</local.sms.jar>
                    <probe.jar>${project.build.directory}/${project.build.finalName}-tests.jar</probe.jar>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
