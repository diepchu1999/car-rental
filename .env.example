# Docker Compose
COMPOSE_FILE=infra/docker-compose.yml
COMPOSE_PROJECT_NAME=car-rental
LOCAL_BIND_ADDRESS=127.0.0.1

# PostgreSQL + PostGIS
POSTGRES_IMAGE=postgis/postgis:17-3.5
POSTGRES_PLATFORM=linux/amd64
POSTGRES_PORT=5432
POSTGRES_MAINTENANCE_DB=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=example_only_postgres_admin_password
POSTGRES_APP_DB=car_rental
POSTGRES_APP_USER=car_rental_app
POSTGRES_APP_PASSWORD=example_only_car_rental_app_password

# Keycloak
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.2
KEYCLOAK_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9990
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=example_only_keycloak_database_password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=example_only_keycloak_admin_password

# Keycloak OTP — BR-129; chỉ dữ liệu giả ở local, SMS in ra log.
CAR_RENTAL_OTP_DIGITS=6
CAR_RENTAL_OTP_LIFETIME=PT5M
CAR_RENTAL_OTP_MAX_FAILURES=5
CAR_RENTAL_OTP_RESEND_DELAY=PT60S
CAR_RENTAL_OTP_PHONE_HOURLY_LIMIT=5
CAR_RENTAL_OTP_PHONE_DAILY_LIMIT=10
CAR_RENTAL_OTP_IP_SEND_HOURLY_LIMIT=20
CAR_RENTAL_OTP_IP_FAILURE_HOURLY_LIMIT=100
# Bắt buộc sinh riêng trong .env: openssl rand -base64 32. Giữ nguyên qua restart.
CAR_RENTAL_OTP_HMAC_SECRET=
CAR_RENTAL_TERMS_VERSION=local-test-v1
# Bắt buộc sinh riêng trong .env. Mật khẩu nhân viên >= 12 ký tự và phải đổi lần đầu.
CAR_RENTAL_KEYCLOAK_READER_SECRET=
CAR_RENTAL_LOCAL_ADMIN_PASSWORD=
CAR_RENTAL_LOCAL_STAFF_PASSWORD=
CAR_RENTAL_LOCAL_MANAGER_A_PASSWORD=
CAR_RENTAL_LOCAL_MANAGER_B_PASSWORD=

# MinIO
MINIO_IMAGE=minio/minio:RELEASE.2025-07-18T21-56-31Z
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=example_only_minio_root_password

# Backend API
CAR_RENTAL_API_PORT=8081
CAR_RENTAL_DB_HOST=127.0.0.1
CAR_RENTAL_TIME_ZONE=Asia/Ho_Chi_Minh
# Địa chỉ Keycloak nhìn từ backend; port phải khớp KEYCLOAK_PORT ở trên.
CAR_RENTAL_KEYCLOAK_BASE_URL=http://localhost:8080
CAR_RENTAL_KEYCLOAK_REALM=car-rental
CAR_RENTAL_KEYCLOAK_READER_CLIENT_ID=identity-reader

# Pricing — BR-218/225, tỷ lệ thập phân: 0.2 = 20%
CAR_RENTAL_PRICING_WEEKEND_DAYS=SATURDAY,SUNDAY
CAR_RENTAL_PRICING_WEEKEND_UPLIFT=0.2
CAR_RENTAL_PRICING_HOLIDAY_UPLIFT=0.5
CAR_RENTAL_QUOTE_VALIDITY=PT15M
CAR_RENTAL_HOLIDAY_DECLARED_THROUGH=2027-12-31
# Bắt buộc, chưa có giá trị — BR-231; Tech Owner tự đặt dữ liệu thử trong .env local.
CAR_RENTAL_INSURANCE_CALCULATION=
CAR_RENTAL_INSURANCE_VALUE=
