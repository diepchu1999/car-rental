      {"name": "DELIVERY_STAFF"}, {"name": "DRIVER"}, {"name": "ACCOUNTANT"},
      {"name": "OPERATIONS_MANAGER"}, {"name": "ADMIN"}, {"name": "HOST"},
      {"name": "BUSINESS_PARTNER"}, {"name": "BUSINESS_PARTNER_STAFF"}, {"name": "FREELANCE_DRIVER"}
