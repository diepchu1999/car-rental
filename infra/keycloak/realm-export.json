  },
  "authenticationFlows": [
    {
      "id": "b8e01000-0000-4000-8000-000000000001", "alias": "car-rental-customer",
      "description": "BR-120/129: SMS then explicit consent for new customers",
      "providerId": "basic-flow", "topLevel": true, "builtIn": false,
      "authenticationExecutions": [
        {"authenticator": "car-rental-customer-otp", "requirement": "REQUIRED", "priority": 10, "authenticatorFlow": false, "userSetupAllowed": false}
      ]
