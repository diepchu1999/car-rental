  "clientScopes": [
    {
      "name": "car-rental-access", "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"},
      "protocolMappers": [
        {"name": "subject", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper", "config": {"access.token.claim": "true", "introspection.token.claim": "true"}},
        {"name": "realm-roles", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-realm-role-mapper", "config": {"claim.name": "realm_access.roles", "jsonType.label": "String", "multivalued": "true", "access.token.claim": "true", "id.token.claim": "false"}},
        {"name": "phone-number", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-property-mapper", "config": {"user.attribute": "username", "claim.name": "phone_number", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true"}},
        {"name": "terms-version", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "config": {"user.attribute": "terms_version", "claim.name": "terms_version", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true"}},
        {"name": "consented-at", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "config": {"user.attribute": "consented_at", "claim.name": "consented_at", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true"}},
        {"name": "backend-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": {"included.custom.audience": "car-rental-api", "access.token.claim": "true", "id.token.claim": "false"}}
      ]
    },
    {
      "name": "car-rental-management", "protocol": "openid-connect",
      "protocolMappers": [
        {"name": "subject", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper", "config": {"access.token.claim": "true", "introspection.token.claim": "true"}},
        {"name": "management-roles", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-client-role-mapper", "config": {"usermodel.clientRoleMapping.clientId": "realm-management", "claim.name": "resource_access.realm-management.roles", "jsonType.label": "String", "multivalued": "true", "access.token.claim": "true", "id.token.claim": "false"}}
      ]
    }
  ],
